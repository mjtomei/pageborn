# Copy to .env.local (gitignored). All versions share the same source tree.
# Exact origins only; never paste a pairing URL or token here.

# PRIVATE debug profile. An optional pairing JSON path enables automatic setup.
# Its token is embedded in the debug package; do not distribute that package.
PAGEBORNE_DEBUG_ASK_ORIGINS=
PAGEBORNE_DEBUG_TERMINAL_STATE=
# PAGEBORNE_DEBUG_ASK_ORIGINS=https://your-terminal.example
# PAGEBORNE_DEBUG_TERMINAL_STATE=/absolute/path/to/terminal/.state/pairing.json
# PAGEBORNE_DEBUG_TERMINAL_URL=https://your-terminal.example
# PAGEBORNE_DEBUG_TERMINAL_AGENT=claude
# Previous origins for the SAME server only (never contacted):
# PAGEBORNE_DEBUG_TERMINAL_PREVIOUS_URLS=https://old-terminal.example

# PUBLIC release: explicit additional network destinations, no connection preset.
# Release ignores the private debug settings above.
PAGEBORNE_RELEASE_ASK_ORIGINS=

# OPTIONAL web companion. The upstream token stays on the server.
# PAGEBORNE_WEB_UPSTREAM=http://127.0.0.1:3456
# PAGEBORNE_WEB_TOKEN_FILE=/absolute/path/to/terminal/.state/token
# Alternative: EVEN_TERMINAL_STATE_DIR=/absolute/path/to/terminal/.state
# PAGEBORNE_WEB_AUTH=tailscale
# PAGEBORNE_WEB_AGENT=claude
# PAGEBORNE_WEB_PORT=3463
# Identity is auto-detected unless both values are set:
# PAGEBORNE_WEB_HOSTNAME=your-device.your-tailnet.ts.net
# PAGEBORNE_WEB_ALLOWED_LOGIN=you@example.com
# PAGEBORNE_WEB_DIST=/absolute/path/to/dist-web
