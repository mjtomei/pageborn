    "test:ask-reply-simulator": "node scripts/ask-reply-simulator.mjs",
    "test:help-text": "node scripts/help-text-browser-test.mjs",
    "test:speech:stream-benchmark": "node scripts/speech-stream-benchmark-browser-test.mjs",
    "test:library-sync": "node scripts/library-sync-browser-test.mjs",
    "test:library-sort": "node scripts/library-sort-browser-test.mjs",
