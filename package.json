{
  "name": "even-reader",
  "version": "0.8.129",
  "private": true,
  "type": "module",
  "description": "Markdown and PDF reading on Even G2 glasses, phones and tablets",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --mode debug --host 127.0.0.1",
    "build": "npm run build:release",
    "preview": "npm run preview:release",
    "start": "node server/cli.js serve",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/browser-test.mjs",
    "test:pdf": "node scripts/pdf-browser-test.mjs",
    "test:pdf-cache": "node scripts/pdf-cache-browser-test.mjs",
    "test:ui": "node scripts/ui-browser-test.mjs",
    "test:diagnostics": "node scripts/diagnostics-browser-test.mjs",
