    "test:simulator:scroll": "npm run build:debug && node scripts/simulator-test.mjs --scroll-repro --record",
    "test:background": "node scripts/pdf-background-test.mjs",
    "test:speed": "node scripts/speed-browser-test.mjs",
    "test:pdf-centering": "node scripts/pdf-centering-browser-test.mjs",
    "test:pdf-notes": "node scripts/pdf-notes-browser-test.mjs",
