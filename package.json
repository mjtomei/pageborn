    "test:reading-controls": "node scripts/reading-controls-browser-test.mjs",
    "test:page-time": "node scripts/page-time-browser-test.mjs",
    "test:pdf-gallery": "node scripts/pdf-gallery-browser-test.mjs",
    "test:pdf-annotations": "node scripts/pdf-annotations-browser-test.mjs",
    "test:transcription-display": "node scripts/transcription-display-browser-test.mjs",
    "test:librarian": "node scripts/librarian-browser-test.mjs",
    "test:speech:startup": "node scripts/speech-startup-browser-test.mjs",
    "test:speed-timing": "node scripts/speed-timing-browser-test.mjs",
    "test:autoscroll-timing": "node scripts/autoscroll-timing-browser-test.mjs",
    "test:ask-status": "node scripts/ask-status-browser-test.mjs",
    "test:ask-sync": "node scripts/ask-sync-browser-test.mjs",
    "test:ask-models": "node scripts/ask-models-browser-test.mjs",
    "test:ask-followups": "node scripts/ask-followups-browser-test.mjs",
    "test:speech:verification": "node scripts/speech-verification-browser-test.mjs",
    "test:web": "node scripts/web-reader-browser-test.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "release:export": "node scripts/release-export.mjs",
    "preview:debug": "vite preview --mode debug --host 127.0.0.1 --port 3461 --strictPort",
    "test:speech:filenames": "node scripts/speech-filenames-browser-test.mjs",
    "test:text-format": "node scripts/text-format-browser-test.mjs",
    "test:pdf-decoders": "node scripts/pdf-decoders-browser-test.mjs",
    "test:pdf-scans": "node scripts/pdf-scans-browser-test.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.14",
    "@evenrealities/pretext": "0.1.4",
    "@pageborne/browser-stt": "git+https://github.com/mjtomei/browser-stt.git#a06c8d7258e38c108505bd71c9a111b991cb45d9",
    "@tesseract.js-data/eng": "1.0.0",
    "jose": "6.2.12",
    "jsqr": "1.4.0",
